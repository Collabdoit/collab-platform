generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Auth Models (NextAuth) ───────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User ────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  companyName   String?        // اسم الشركة

  accounts      Account[]
  sessions      Session[]
  hiredAgents   HiredAgent[]
  tasks         Task[]
  subscription  Subscription?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Agent (AI Employee) ──────────────────────────────────

model Agent {
  id            String       @id @default(cuid())
  nameAr        String       // نورة، فهد
  nameEn        String       // Noura, Fahd
  roleAr        String       // استراتيجية المحتوى
  roleEn        String       // Content Strategist
  titleAr       String       // المسمى الوظيفي
  titleEn       String
  avatar        String       // Emoji or URL
  color         String       @default("#6366F1") // Accent color for 3D avatar
  personalityAr String       // شخصية الموظف
  personalityEn String
  systemPrompt  String       @db.Text
  tier          String       @default("STARTER") // STARTER, GROWTH, ENTERPRISE
  salary        Int          // Monthly cost in SAR
  department    String       // Content, Advertising, Analytics
  departmentAr  String       // المحتوى، الإعلانات، التحليلات
  isActive      Boolean      @default(true)

  skills        AgentSkill[]
  hiredBy       HiredAgent[]

  createdAt     DateTime     @default(now())
}

// ─── Agent Skill (Callable Capability) ────────────────────

model AgentSkill {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  nameAr        String   // تقويم المحتوى
  nameEn        String   // Content Calendar
  descriptionAr String   // وصف المهارة
  descriptionEn String
  instruction   String   @db.Text // Appended to system prompt when executing
  icon          String   @default("📝") // Emoji icon
  inputSchema   String?  @db.Text // JSON schema for required user inputs
  outputFormat  String   @default("markdown") // markdown, json, html
  estimatedTime Int      @default(30) // Estimated seconds

  tasks         Task[]

  createdAt     DateTime @default(now())
}

// ─── Hired Agent (Employment Record) ──────────────────────

model HiredAgent {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId  String
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  status   String    @default("IDLE") // IDLE, WORKING, BLOCKED
  hiredAt  DateTime  @default(now())
  firedAt  DateTime? // null = still employed

  tasks    Task[]

  @@unique([userId, agentId])
}

// ─── Task (Unit of Work) ──────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiredAgentId String
  hiredAgent   HiredAgent   @relation(fields: [hiredAgentId], references: [id], onDelete: Cascade)
  skillId      String
  skill        AgentSkill   @relation(fields: [skillId], references: [id])

  title        String
  briefing     String       @db.Text // User's input/brief
  status       String       @default("QUEUED") // QUEUED, IN_PROGRESS, COMPLETED, FAILED
  priority     String       @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  deliverable  Deliverable?

  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
}

// ─── Deliverable (AI Output) ──────────────────────────────

model Deliverable {
  id        String   @id @default(cuid())
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content   String   @db.Text // The actual AI-generated output
  format    String   @default("markdown")
  rating    Int?     // User satisfaction 1-5
  feedback  String?  // User feedback on deliverable

  createdAt DateTime @default(now())
}

// ─── Subscription (Billing) ───────────────────────────────

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier              String   @default("FREE") // FREE, STARTER, GROWTH, ENTERPRISE
  monthlyBudget     Int      @default(0) // Total salary of all hired agents in SAR
  tasksUsed         Int      @default(0) // Tasks used this billing cycle
  tasksLimit        Int      @default(5) // Max tasks per month
  billingCycleStart DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

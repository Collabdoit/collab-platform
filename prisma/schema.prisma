generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─── Auth Models (NextAuth) ───────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User ────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  companyName   String?

  accounts      Account[]
  sessions      Session[]
  hiredAgents   HiredAgent[]
  tasks         Task[]
  interviews    Interview[]
  subscription  Subscription?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Agent (AI Employee) ──────────────────────────────────

model Agent {
  id              String       @id @default(cuid())
  nameAr          String
  nameEn          String
  roleAr          String
  roleEn          String
  titleAr         String
  titleEn         String
  avatar          String
  color           String       @default("#6366F1")
  personalityAr   String
  personalityEn   String
  systemPrompt    String       @db.Text
  interviewPrompt String       @db.Text @default("")
  tier            String       @default("STARTER")
  salary          Int          // Base monthly cost in SAR (ask price)
  minSalary       Int          @default(0) // Floor for negotiation
  department      String
  departmentAr    String
  aiProvider      String       @default("claude") // "claude" | "gpt"
  aiModel         String?      // Optional model override (e.g. "gpt-4o-mini")
  isActive        Boolean      @default(true)

  skills          AgentSkill[]
  hiredBy         HiredAgent[]
  interviews      Interview[]

  createdAt       DateTime     @default(now())
}

// ─── Agent Skill (Callable Capability) ────────────────────

model AgentSkill {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  nameAr        String
  nameEn        String
  descriptionAr String
  descriptionEn String
  instruction   String   @db.Text
  icon          String   @default("📝")
  inputSchema   String?  @db.Text
  outputFormat  String   @default("markdown")
  estimatedTime Int      @default(30)

  tasks         Task[]

  createdAt     DateTime @default(now())
}

// ─── Hired Agent (Employment Record) ──────────────────────

model HiredAgent {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  status         String    @default("IDLE")
  agreedSalary   Int?      // Negotiated salary (null = base salary)
  hiredAt        DateTime  @default(now())
  firedAt        DateTime?

  tasks          Task[]

  @@unique([userId, agentId])
}

// ─── Interview (Chat Before Hiring) ───────────────────────

model Interview {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)

  messages     InterviewMessage[]
  agreedSalary Int?               // Final negotiated salary
  status       String             @default("ACTIVE") // ACTIVE, HIRED, DECLINED

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model InterviewMessage {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  role        String    // "user" | "agent"
  content     String    @db.Text

  createdAt   DateTime  @default(now())
}

// ─── Task (Unit of Work) ──────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiredAgentId String
  hiredAgent   HiredAgent   @relation(fields: [hiredAgentId], references: [id], onDelete: Cascade)
  skillId      String
  skill        AgentSkill   @relation(fields: [skillId], references: [id])

  title        String
  briefing     String       @db.Text
  status       String       @default("QUEUED")
  priority     String       @default("NORMAL")
  tokensUsed   Int          @default(0) // Actual API tokens consumed

  deliverable  Deliverable?

  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
}

// ─── Deliverable (AI Output) ──────────────────────────────

model Deliverable {
  id        String   @id @default(cuid())
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  format    String   @default("markdown")
  rating    Int?
  feedback  String?

  createdAt DateTime @default(now())
}

// ─── Subscription (Token-Based Billing) ───────────────────

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier              String   @default("FREE")
  monthlyBudget     Int      @default(0)       // Total salary of hired agents in SAR
  tokensBudget      Int      @default(10000)    // Purchased token budget
  tokensUsed        Int      @default(0)        // Tokens consumed this cycle
  maxOverage        Float    @default(0.10)     // 10% max overage
  billingCycleStart DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
